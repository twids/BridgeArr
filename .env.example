# BridgeArr environment configuration
# Copy this file to .env and fill in the values before running docker compose.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=bridgearr
POSTGRES_USER=bridgearr
POSTGRES_PASSWORD=change_me_in_production

# ---------------------------------------------------------------------------
# BridgeArr — Authentication (ASP.NET Core)
# ---------------------------------------------------------------------------
# Set to Production for production deployments
ASPNETCORE_ENVIRONMENT=Production
BRIDGEARR_PORT=8080

# ---------------------------------------------------------------------------
# BridgeArr — Integration settings
# Configure these after the application starts and you have added integrations
# via the admin UI. These environment variables are passed into the container
# and can be referenced when configuring plugin integrations.
# ---------------------------------------------------------------------------
PLEX_URL=http://your-plex-server:32400
PLEX_TOKEN=your_plex_token

RADARR_URL=http://your-radarr:7878
RADARR_APIKEY=your_radarr_api_key

SONARR_URL=http://your-sonarr:8989
SONARR_APIKEY=your_sonarr_api_key
