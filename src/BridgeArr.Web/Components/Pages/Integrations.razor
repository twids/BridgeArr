@page "/integrations"
@attribute [Authorize(Policy = "Admin")]
@inject BridgeArr.Application.Services.IntegrationService IntegrationService

<PageTitle>Connections – BridgeArr</PageTitle>

<header class="page-header">
    <div><span class="eyebrow">Sources & targets</span><h1>Connections</h1><p>Connect BridgeArr to the services that provide and receive your media labels.</p></div>
    <button class="btn btn-primary" @onclick="OpenAddForm">Add connection <span aria-hidden="true">+</span></button>
</header>

<AlertBanner Message="@alertMessage" IsError="@alertIsError" OnDismiss="@(() => alertMessage = null)" />

<LoadingSpinner IsLoading="@isLoading" Text="Checking connections…">
    @if (integrations.Count == 0)
    {
        <section class="panel empty-state hero-empty"><span>↔</span><h2>Connect your media stack</h2><p>Add Radarr, Sonarr or Plex. Credentials stay in your BridgeArr database and are never shown in the connection list.</p><button class="btn btn-primary" @onclick="OpenAddForm">Add first connection</button></section>
    }
    else
    {
        <div class="connection-grid">
            @foreach (var integration in integrations)
            {
                <article class="connection-card">
                    <div class="connection-top">
                        <span class="service-mark service-@integration.PluginType">@ServiceInitial(integration.PluginType)</span>
                        <div><span class="eyebrow">@DisplayPlugin(integration.PluginType)</span><h2>@integration.Name</h2></div>
                        <StatusBadge Status="@(integration.Enabled ? "Enabled" : "Disabled")" />
                    </div>
                    <div class="connection-url"><span>Endpoint</span><strong>@ReadUrl(integration.ConfigurationJson)</strong></div>
                    <div class="connection-actions">
                        <button class="btn btn-secondary btn-sm" @onclick="() => TestConnection(integration.Id)" disabled="@isBusy">Test connection</button>
                        <button class="text-button" @onclick="() => OpenEditForm(integration)">Edit</button>
                        <button class="text-button" @onclick="() => ToggleEnabled(integration)" disabled="@isBusy">@(integration.Enabled ? "Disable" : "Enable")</button>
                        <button class="text-button text-danger" @onclick="() => ConfirmDelete(integration)">Delete</button>
                    </div>
                </article>
            }
        </div>
    }
</LoadingSpinner>

@if (showForm)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="form-title">
        <div class="modal modal-wide">
            <div class="modal-heading"><div><span class="eyebrow">@(isEditing ? "Connection details" : "New connection")</span><h2 id="form-title">@(isEditing ? $"Edit {formModel.Name}" : "Add a service")</h2></div><button class="icon-button" type="button" @onclick="CloseForm" aria-label="Close">×</button></div>
            <EditForm Model="formModel" OnValidSubmit="SaveIntegration" FormName="IntegrationForm">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-group"><label>Name <span class="required">*</span></label><InputText class="form-control" @bind-Value="formModel.Name" placeholder="My Radarr" /><ValidationMessage For="() => formModel.Name" /></div>
                    <div class="form-group"><label>Service <span class="required">*</span></label><InputSelect class="form-control" @bind-Value="formModel.PluginType" disabled="@isEditing"><option value="">Select a service</option>@foreach (var plugin in plugins) { <option value="@plugin.PluginType">@plugin.DisplayName</option> }</InputSelect><ValidationMessage For="() => formModel.PluginType" /></div>
                </div>
                <div class="form-group"><label>Server URL <span class="required">*</span></label><InputText class="form-control" @bind-Value="formModel.Url" type="url" placeholder="http://192.168.1.48:7878" /><small>Use the URL reachable from the BridgeArr container.</small></div>
                <div class="form-group"><label>@CredentialLabel <span class="required">*</span></label><InputText class="form-control" @bind-Value="formModel.Credential" type="password" autocomplete="new-password" placeholder="@(isEditing ? "Leave blank to keep the current credential" : "Paste credential")" /><small>@(isEditing ? "The saved credential is never displayed. Enter a new value only to replace it." : "Stored in the BridgeArr database and omitted from this UI after saving.")</small></div>
                <label class="switch-row"><span><strong>Connection enabled</strong><small>Disabled connections cannot be used by routes.</small></span><InputCheckbox @bind-Value="formModel.Enabled" /></label>
                @if (formError is not null) { <div class="inline-error">@formError</div> }
                <div class="modal-actions"><button class="btn btn-primary" type="submit" disabled="@isBusy">@(isBusy ? "Saving…" : "Save connection")</button><button class="btn btn-secondary" type="button" @onclick="CloseForm">Cancel</button></div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showDeleteConfirm" Title="Delete connection" Message="@deleteConfirmMessage" ConfirmLabel="Delete" OnConfirm="ExecuteDelete" OnCancel="@(() => showDeleteConfirm = false)" />

@code {
    private bool isLoading = true;
    private bool isBusy;
    private bool showForm;
    private bool isEditing;
    private bool showDeleteConfirm;
    private string? alertMessage;
    private bool alertIsError;
    private string? formError;
    private string existingCredential = string.Empty;
    private string deleteConfirmMessage = string.Empty;
    private Guid deleteTargetId;
    private IReadOnlyList<Integration> integrations = Array.Empty<Integration>();
    private IReadOnlyList<BridgeArr.Plugins.Abstractions.IPlugin> plugins = Array.Empty<BridgeArr.Plugins.Abstractions.IPlugin>();
    private IntegrationFormModel formModel = new();
    private string CredentialLabel => formModel.PluginType.Equals("plex", StringComparison.OrdinalIgnoreCase) ? "Plex token" : "API key";

    protected override async Task OnInitializedAsync()
    {
        try { integrations = await IntegrationService.GetAllAsync(); plugins = IntegrationService.GetAvailablePlugins().ToList(); }
        finally { isLoading = false; }
    }

    private void OpenAddForm() { formModel = new(); existingCredential = string.Empty; isEditing = false; formError = null; showForm = true; }
    private void OpenEditForm(Integration integration)
    {
        formModel = new() { Id = integration.Id, Name = integration.Name, PluginType = integration.PluginType, Enabled = integration.Enabled, Url = ReadConfigValue(integration.ConfigurationJson, "url") };
        existingCredential = ReadConfigValue(integration.ConfigurationJson, integration.PluginType.Equals("plex", StringComparison.OrdinalIgnoreCase) ? "token" : "apiKey");
        isEditing = true; formError = null; showForm = true;
    }
    private void CloseForm() => showForm = false;

    private async Task SaveIntegration()
    {
        formError = null;
        if (!Uri.TryCreate(formModel.Url, UriKind.Absolute, out var uri) || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)) { formError = "Enter a complete http:// or https:// server URL."; return; }
        var credential = string.IsNullOrWhiteSpace(formModel.Credential) ? existingCredential : formModel.Credential.Trim();
        if (string.IsNullOrWhiteSpace(credential)) { formError = $"{CredentialLabel} is required."; return; }
        isBusy = true;
        try
        {
            var config = formModel.PluginType.Equals("plex", StringComparison.OrdinalIgnoreCase)
                ? System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["url"] = formModel.Url.TrimEnd('/'), ["token"] = credential })
                : System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["url"] = formModel.Url.TrimEnd('/'), ["apiKey"] = credential });
            var entity = new Integration { Id = formModel.Id ?? Guid.NewGuid(), Name = formModel.Name.Trim(), PluginType = formModel.PluginType, Enabled = formModel.Enabled, ConfigurationJson = config };
            if (isEditing) await IntegrationService.UpdateAsync(entity); else await IntegrationService.CreateAsync(entity);
            integrations = await IntegrationService.GetAllAsync(); showForm = false; ShowSuccess(isEditing ? "Connection updated." : "Connection added.");
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { isBusy = false; }
    }

    private async Task ToggleEnabled(Integration integration)
    {
        isBusy = true;
        try { integration.Enabled = !integration.Enabled; await IntegrationService.UpdateAsync(integration); integrations = await IntegrationService.GetAllAsync(); ShowSuccess($"{integration.Name} {(integration.Enabled ? "enabled" : "disabled")}."); }
        catch (Exception ex) { ShowError($"Could not update connection: {ex.Message}"); }
        finally { isBusy = false; }
    }
    private async Task TestConnection(Guid id)
    {
        isBusy = true; alertMessage = null;
        try { if (await IntegrationService.TestConnectionAsync(id)) ShowSuccess("Connection test succeeded."); else ShowError("Connection test failed. Check the server URL and credential."); }
        catch (Exception ex) { ShowError($"Connection test failed: {ex.Message}"); }
        finally { isBusy = false; }
    }
    private void ConfirmDelete(Integration integration) { deleteTargetId = integration.Id; deleteConfirmMessage = $"Delete {integration.Name}? Routes using it must be removed first."; showDeleteConfirm = true; }
    private async Task ExecuteDelete()
    {
        showDeleteConfirm = false; isBusy = true;
        try { await IntegrationService.DeleteAsync(deleteTargetId); integrations = await IntegrationService.GetAllAsync(); ShowSuccess("Connection deleted."); }
        catch (Exception ex) { ShowError($"Could not delete connection: {ex.Message}"); }
        finally { isBusy = false; }
    }

    private static string DisplayPlugin(string pluginType) => pluginType.ToLowerInvariant() switch { "radarr" => "Radarr source", "sonarr" => "Sonarr source", "plex" => "Plex target", _ => pluginType };
    private static string ServiceInitial(string pluginType) => string.IsNullOrWhiteSpace(pluginType) ? "?" : pluginType[..1].ToUpperInvariant();
    private static string ReadUrl(string json) { var value = ReadConfigValue(json, "url"); return string.IsNullOrWhiteSpace(value) ? "Not configured" : value; }
    private static string ReadConfigValue(string json, string property)
    {
        try { using var document = System.Text.Json.JsonDocument.Parse(json); foreach (var item in document.RootElement.EnumerateObject()) if (item.Name.Equals(property, StringComparison.OrdinalIgnoreCase)) return item.Value.GetString() ?? string.Empty; }
        catch (System.Text.Json.JsonException) { }
        return string.Empty;
    }
    private void ShowSuccess(string message) { alertMessage = message; alertIsError = false; }
    private void ShowError(string message) { alertMessage = message; alertIsError = true; }

    private sealed class IntegrationFormModel
    {
        public Guid? Id { get; set; }
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)] public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Service is required.")] public string PluginType { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Credential { get; set; } = string.Empty;
        public bool Enabled { get; set; } = true;
    }
}
