@page "/activity"
@page "/logs"
@attribute [Authorize]
@inject BridgeArr.Application.Interfaces.ISyncJobRepository SyncJobRepository
@inject BridgeArr.Application.Interfaces.IWebhookEventRepository WebhookEventRepository

<PageTitle>Activity – BridgeArr</PageTitle>

<header class="page-header">
    <div><span class="eyebrow">History & diagnostics</span><h1>Activity</h1><p>Follow label syncs, investigate failures and inspect incoming webhooks when needed.</p></div>
</header>

<LoadingSpinner IsLoading="@isLoading" Text="Loading activity…">
    <div class="segmented-control" role="tablist">
        <button class="@(activeView == "sync" ? "active" : "")" @onclick='@(() => activeView = "sync")'>Sync runs <span>@filteredJobs.Count</span></button>
        <button class="@(activeView == "webhooks" ? "active" : "")" @onclick='@(() => activeView = "webhooks")'>Webhook diagnostics <span>@filteredEvents.Count</span></button>
    </div>

    @if (activeView == "sync")
    {
        <section class="panel">
            <div class="section-header"><div><span class="eyebrow">Latest 100</span><h2>Sync runs</h2></div><div class="filter-bar"><select class="form-control form-control-sm" @bind="jobStatusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<SyncJobStatus>()) { <option value="@status">@status</option> }</select><button class="btn btn-secondary btn-sm" @onclick="ClearFilters">Clear</button></div></div>
            @if (filteredJobs.Count == 0)
            {
                <div class="empty-state compact"><p>No sync runs match this filter.</p></div>
            }
            else
            {
                <div class="activity-table" role="table">
                    @foreach (var job in filteredJobs)
                    {
                        <button class="activity-table-row" @onclick="() => selectedJob = job">
                            <StatusBadge Status="@job.Status.ToString()" />
                            <span><strong>@job.SourceIntegration?.Name → @job.TargetIntegration?.Name</strong><small>@job.CreatedAt.ToLocalTime().ToString("g")</small></span>
                            <span class="activity-result">@(job.Status == SyncJobStatus.Failed ? "Needs attention" : FormatDuration(job))</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <section class="panel diagnostics-panel">
            <div class="section-header"><div><span class="eyebrow">Advanced</span><h2>Webhook diagnostics</h2><p>Raw inbound events for troubleshooting source-triggered syncs.</p></div></div>
            <div class="filter-bar activity-filters"><input class="form-control form-control-sm" type="search" placeholder="Search source or event…" @bind="eventSearch" @bind:after="ApplyFilters" /><select class="form-control form-control-sm" @bind="eventStatusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="pending">Pending</option><option value="processed">Processed</option><option value="error">Errors</option></select><button class="btn btn-secondary btn-sm" @onclick="ClearFilters">Clear</button></div>
            @if (filteredEvents.Count == 0)
            {
                <div class="empty-state compact"><p>No webhook events match this filter.</p></div>
            }
            else
            {
                <div class="activity-table">
                    @foreach (var evt in filteredEvents)
                    {
                        <button class="activity-table-row" @onclick="() => selectedEvent = evt"><StatusBadge Status="@EventStatus(evt)" /><span><strong>@evt.Source · @evt.EventType</strong><small>@evt.ReceivedAt.ToLocalTime().ToString("g")</small></span><span class="activity-result">@EventStatus(evt)</span><span aria-hidden="true">›</span></button>
                    }
                </div>
            }
        </section>
    }
</LoadingSpinner>

@if (selectedJob is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><div class="modal-heading"><div><span class="eyebrow">Sync run</span><h2>@selectedJob.SourceIntegration?.Name → @selectedJob.TargetIntegration?.Name</h2></div><button class="icon-button" @onclick="() => selectedJob = null">×</button></div><dl class="detail-grid"><dt>Status</dt><dd><StatusBadge Status="@selectedJob.Status.ToString()" /></dd><dt>Started</dt><dd>@selectedJob.CreatedAt.ToLocalTime().ToString("g")</dd><dt>Duration</dt><dd>@FormatDuration(selectedJob)</dd><dt>Retries</dt><dd>@selectedJob.RetryCount</dd>@if (!string.IsNullOrWhiteSpace(selectedJob.ErrorMessage)) { <dt>Error</dt><dd class="text-danger">@selectedJob.ErrorMessage</dd> }</dl>@if (!string.IsNullOrWhiteSpace(selectedJob.Payload)) { <details class="technical-details"><summary>Technical payload</summary><pre class="code-block">@selectedJob.Payload</pre></details> }</div></div>
}
@if (selectedEvent is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><div class="modal-heading"><div><span class="eyebrow">Webhook diagnostic</span><h2>@selectedEvent.Source · @selectedEvent.EventType</h2></div><button class="icon-button" @onclick="() => selectedEvent = null">×</button></div><dl class="detail-grid"><dt>Status</dt><dd><StatusBadge Status="@EventStatus(selectedEvent)" /></dd><dt>Received</dt><dd>@selectedEvent.ReceivedAt.ToLocalTime().ToString("g")</dd><dt>Processed</dt><dd>@(selectedEvent.ProcessedAt?.ToLocalTime().ToString("g") ?? "Not yet")</dd>@if (!string.IsNullOrWhiteSpace(selectedEvent.ProcessingError)) { <dt>Error</dt><dd class="text-danger">@selectedEvent.ProcessingError</dd> }</dl><details class="technical-details"><summary>Raw webhook payload</summary><pre class="code-block">@selectedEvent.Payload</pre></details></div></div>
}

@code {
    private bool isLoading = true;
    private string activeView = "sync";
    private string jobStatusFilter = string.Empty;
    private string eventStatusFilter = string.Empty;
    private string eventSearch = string.Empty;
    private IReadOnlyList<SyncJob> allJobs = Array.Empty<SyncJob>();
    private IReadOnlyList<SyncJob> filteredJobs = Array.Empty<SyncJob>();
    private IReadOnlyList<WebhookEvent> allEvents = Array.Empty<WebhookEvent>();
    private IReadOnlyList<WebhookEvent> filteredEvents = Array.Empty<WebhookEvent>();
    private SyncJob? selectedJob;
    private WebhookEvent? selectedEvent;

    protected override async Task OnInitializedAsync()
    {
        try { allJobs = await SyncJobRepository.GetRecentAsync(100); allEvents = await WebhookEventRepository.GetRecentAsync(100); ApplyFilters(); }
        finally { isLoading = false; }
    }
    private void ApplyFilters()
    {
        filteredJobs = string.IsNullOrWhiteSpace(jobStatusFilter) || !Enum.TryParse<SyncJobStatus>(jobStatusFilter, out var status) ? allJobs : allJobs.Where(x => x.Status == status).ToList();
        var events = allEvents.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(eventSearch)) events = events.Where(x => x.Source.Contains(eventSearch, StringComparison.OrdinalIgnoreCase) || x.EventType.Contains(eventSearch, StringComparison.OrdinalIgnoreCase));
        events = eventStatusFilter switch { "pending" => events.Where(x => !x.Processed), "processed" => events.Where(x => x.Processed && x.ProcessingError is null), "error" => events.Where(x => x.ProcessingError is not null), _ => events };
        filteredEvents = events.ToList();
    }
    private void ClearFilters() { jobStatusFilter = string.Empty; eventStatusFilter = string.Empty; eventSearch = string.Empty; ApplyFilters(); }
    private static string EventStatus(WebhookEvent evt) => evt.ProcessingError is not null ? "Failed" : evt.Processed ? "Completed" : "Queued";
    private static string FormatDuration(SyncJob job)
    {
        if (job.StartedAt is null) return job.Status == SyncJobStatus.Queued ? "Waiting" : "—";
        var end = job.CompletedAt ?? DateTimeOffset.UtcNow; var duration = end - job.StartedAt.Value;
        return duration.TotalSeconds < 60 ? $"{duration.TotalSeconds:F1}s" : $"{duration.TotalMinutes:F1}m";
    }
}
