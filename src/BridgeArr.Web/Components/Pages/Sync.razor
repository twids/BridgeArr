@page "/sync"
@attribute [Authorize]
@inject BridgeArr.Application.Interfaces.ISyncJobRepository SyncJobRepository
@inject BridgeArr.Application.Services.SyncService SyncService
@inject BridgeArr.Application.Services.SyncRouteService SyncRouteService
@inject BridgeArr.Application.Services.IntegrationService IntegrationService

<PageTitle>Sync – BridgeArr</PageTitle>

<h1>Synchronization</h1>

<AlertBanner Message="@alertMessage" IsError="@alertIsError" OnDismiss="@(() => alertMessage = null)" />
<section class="content-card">
    <div class="section-header">
        <h2>Sync routes</h2>
        <button class="btn btn-primary btn-sm" @onclick="OpenRouteForm">Add route</button>
    </div>
    @if (routes.Count == 0)
    {
        <p class="muted">No scheduled synchronization routes configured.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Name</th><th>Source</th><th>Target</th><th>Interval</th><th>Last queued</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var route in routes)
            {
                <tr>
                    <td>@route.Name</td>
                    <td>@route.SourceIntegration?.Name</td>
                    <td>@route.TargetIntegration?.Name</td>
                    <td>@route.IntervalMinutes min</td>
                    <td>@(route.LastQueuedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                    <td class="action-cell">
                        <button class="btn btn-primary btn-sm" @onclick="() => RunRoute(route)" disabled="@isBusy">Run now</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => EditRoute(route)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteRoute(route.Id)">Delete</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@if (showRouteForm)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="route-title">
        <div class="modal">
            <h2 id="route-title">@(routeForm.Id == Guid.Empty ? "Add sync route" : "Edit sync route")</h2>
            <EditForm Model="routeForm" OnValidSubmit="SaveRoute" FormName="SyncRouteForm">
                <DataAnnotationsValidator />
                <div class="form-group"><label>Name</label><InputText class="form-control" @bind-Value="routeForm.Name" /></div>
                <div class="form-group"><label>Source</label><InputSelect class="form-control" @bind-Value="routeForm.SourceIntegrationId">
                    <option value="@Guid.Empty">Select source</option>
                    @foreach (var item in sourceIntegrations) { <option value="@item.Id">@item.Name</option> }
                </InputSelect></div>
                <div class="form-group"><label>Target</label><InputSelect class="form-control" @bind-Value="routeForm.TargetIntegrationId">
                    <option value="@Guid.Empty">Select target</option>
                    @foreach (var item in targetIntegrations) { <option value="@item.Id">@item.Name</option> }
                </InputSelect></div>
                <div class="form-group"><label>Interval (minutes)</label><InputNumber class="form-control" @bind-Value="routeForm.IntervalMinutes" /></div>
                <div class="form-group"><label class="checkbox-label"><InputCheckbox @bind-Value="routeForm.Enabled" /> Enabled</label></div>
                <div class="modal-actions"><button class="btn btn-primary" type="submit">Save</button><button class="btn btn-secondary" type="button" @onclick="CloseRouteForm">Cancel</button></div>
            </EditForm>
        </div>
    </div>
}

<LoadingSpinner IsLoading="@isLoading" Text="Loading sync jobs…">
    <section class="content-card">
        <div class="section-header">
            <h2>Sync jobs</h2>
            <div class="filter-bar">
                <select class="form-control form-control-sm" @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<SyncJobStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        @if (filteredJobs.Count == 0)
        {
            <p class="muted">No synchronization jobs @(statusFilter != "" ? $"with status \"{statusFilter}\"" : "have been recorded") yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Target</th>
                        <th>Created</th>
                        <th>Duration</th>
                        <th>Retries</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in filteredJobs)
                    {
                        <tr>
                            <td><StatusBadge Status="@job.Status.ToString()" /></td>
                            <td>@(job.SourceIntegration?.Name ?? job.SourceIntegrationId.ToString()[..8])</td>
                            <td>@(job.TargetIntegration?.Name ?? job.TargetIntegrationId.ToString()[..8])</td>
                            <td>@job.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>@FormatDuration(job)</td>
                            <td>@job.RetryCount</td>
                            <td class="action-cell">
                                <button class="btn btn-secondary btn-sm"
                                        @onclick="() => ViewDetails(job)">Details</button>
                                @if (job.Status == SyncJobStatus.Failed)
                                {
                                    <button class="btn btn-primary btn-sm"
                                            @onclick="() => RetryJob(job)"
                                            disabled="@isBusy">Retry</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</LoadingSpinner>

@* Job details panel *@
@if (selectedJob is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="details-title">
        <div class="modal">
            <h2 id="details-title">Sync job details</h2>
            <dl class="detail-grid">
                <dt>ID</dt>
                <dd><code>@selectedJob.Id</code></dd>
                <dt>Status</dt>
                <dd><StatusBadge Status="@selectedJob.Status.ToString()" /></dd>
                <dt>Source</dt>
                <dd>@(selectedJob.SourceIntegration?.Name ?? selectedJob.SourceIntegrationId.ToString())</dd>
                <dt>Target</dt>
                <dd>@(selectedJob.TargetIntegration?.Name ?? selectedJob.TargetIntegrationId.ToString())</dd>
                <dt>Created</dt>
                <dd>@selectedJob.CreatedAt.ToLocalTime().ToString("u")</dd>
                <dt>Started</dt>
                <dd>@(selectedJob.StartedAt?.ToLocalTime().ToString("u") ?? "—")</dd>
                <dt>Completed</dt>
                <dd>@(selectedJob.CompletedAt?.ToLocalTime().ToString("u") ?? "—")</dd>
                <dt>Duration</dt>
                <dd>@FormatDuration(selectedJob)</dd>
                <dt>Retry count</dt>
                <dd>@selectedJob.RetryCount</dd>
                @if (selectedJob.ErrorMessage is not null)
                {
                    <dt>Error</dt>
                    <dd class="text-danger">@selectedJob.ErrorMessage</dd>
                }
                @if (selectedJob.Payload is not null)
                {
                    <dt>Payload</dt>
                    <dd><pre class="code-block">@selectedJob.Payload</pre></dd>
                }
            </dl>
            <div class="modal-actions">
                @if (selectedJob.Status == SyncJobStatus.Failed)
                {
                    <button class="btn btn-primary" @onclick="() => RetryJob(selectedJob)" disabled="@isBusy">
                        Retry job
                    </button>
                }
                <button class="btn btn-secondary" @onclick="CloseDetails">Close</button>
            </div>
        </div>
    </div>
}
@code {
    private bool isLoading = true;
    private bool isBusy;
    private string statusFilter = "";
    private string? alertMessage;
    private bool alertIsError;

    private IReadOnlyList<SyncJob> jobs = Array.Empty<SyncJob>();
    private IReadOnlyList<SyncJob> filteredJobs = Array.Empty<SyncJob>();
    private SyncJob? selectedJob;
    private IReadOnlyList<SyncRoute> routes = Array.Empty<SyncRoute>();
    private IReadOnlyList<Integration> sourceIntegrations = Array.Empty<Integration>();
    private IReadOnlyList<Integration> targetIntegrations = Array.Empty<Integration>();
    private SyncRoute routeForm = new();
    private bool showRouteForm;

    private async Task LoadRoutes()
    {
        routes = await SyncRouteService.GetAllAsync();
        var integrations = await IntegrationService.GetAllAsync();
        var plugins = IntegrationService.GetAvailablePlugins().ToList();
        var sourceTypes = plugins.Where(x => x.Capabilities.HasFlag(BridgeArr.Plugins.Abstractions.PluginCapabilities.MediaSource)).Select(x => x.PluginType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var targetTypes = plugins.Where(x => x.Capabilities.HasFlag(BridgeArr.Plugins.Abstractions.PluginCapabilities.MediaTarget)).Select(x => x.PluginType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        sourceIntegrations = integrations.Where(x => x.Enabled && sourceTypes.Contains(x.PluginType)).ToList();
        targetIntegrations = integrations.Where(x => x.Enabled && targetTypes.Contains(x.PluginType)).ToList();
    }

    private void OpenRouteForm()
    {
        routeForm = new SyncRoute { IntervalMinutes = 60, Enabled = true };
        showRouteForm = true;
    }

    private void EditRoute(SyncRoute route)
    {
        routeForm = new SyncRoute { Id = route.Id, Name = route.Name, SourceIntegrationId = route.SourceIntegrationId, TargetIntegrationId = route.TargetIntegrationId, Enabled = route.Enabled, IntervalMinutes = route.IntervalMinutes, LastQueuedAt = route.LastQueuedAt, CreatedAt = route.CreatedAt };
        showRouteForm = true;
    }

    private void CloseRouteForm() => showRouteForm = false;

    private async Task SaveRoute()
    {
        try
        {
            if (routeForm.Id == Guid.Empty) await SyncRouteService.CreateAsync(routeForm);
            else await SyncRouteService.UpdateAsync(routeForm);
            showRouteForm = false;
            await LoadRoutes();
            ShowSuccess("Sync route saved.");
        }
        catch (Exception ex) { ShowError($"Failed to save route: {ex.Message}"); }
    }

    private async Task RunRoute(SyncRoute route)
    {
        isBusy = true;
        try
        {
            var job = await SyncRouteService.QueueAsync(route);
            await LoadRoutes();
            await LoadRoutes();
            await LoadJobs();
            if (job is null) ShowError("A matching sync job is already active.");
            else ShowSuccess($"Sync queued as job {job.Id}.");
        }
        catch (Exception ex) { ShowError($"Failed to run route: {ex.Message}"); }
        finally { isBusy = false; }
    }

    private async Task DeleteRoute(Guid id)
    {
        await SyncRouteService.DeleteAsync(id);
        await LoadRoutes();
        ShowSuccess("Sync route deleted.");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRoutes();
            await LoadJobs();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadJobs()
    {
        jobs = await SyncJobRepository.GetRecentAsync(100);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(statusFilter) ||
            !Enum.TryParse<SyncJobStatus>(statusFilter, out var filter))
        {
            filteredJobs = jobs;
            return;
        }
        filteredJobs = jobs.Where(j => j.Status == filter).ToList();
    }

    private async Task RetryJob(SyncJob job)
    {
        isBusy = true;
        alertMessage = null;
        try
        {
            var newJob = await SyncService.RequestSyncAsync(
                job.SourceIntegrationId,
                job.TargetIntegrationId,
                job.Payload);

            ShowSuccess($"Retry queued as job {newJob.Id}.");
            selectedJob = null;
            await LoadJobs();
        }
        catch (Exception ex)
        {
            ShowError($"Failed to retry job: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ViewDetails(SyncJob job) => selectedJob = job;
    private void CloseDetails() => selectedJob = null;

    private static string FormatDuration(SyncJob job)
    {
        if (job.StartedAt is null || job.CompletedAt is null)
        {
            return "—";
        }
        var duration = job.CompletedAt.Value - job.StartedAt.Value;
        return duration.TotalSeconds < 60
            ? $"{duration.TotalSeconds:F1}s"
            : $"{duration.TotalMinutes:F1}m";
    }

    private void ShowSuccess(string message) { alertMessage = message; alertIsError = false; }
    private void ShowError(string message) { alertMessage = message; alertIsError = true; }
}

