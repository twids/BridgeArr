@page "/sync"
@attribute [Authorize]
@inject BridgeArr.Application.Interfaces.ISyncJobRepository SyncJobRepository
@inject BridgeArr.Application.Services.SyncService SyncService
@inject BridgeArr.Application.Services.SyncRouteService SyncRouteService
@inject BridgeArr.Application.Services.IntegrationService IntegrationService

<PageTitle>Routes – BridgeArr</PageTitle>

<header class="page-header">
    <div><span class="eyebrow">Label automation</span><h1>Routes</h1><p>Choose where labels come from, where they go and how often BridgeArr checks for changes.</p></div>
    <button class="btn btn-primary" @onclick="OpenRouteForm">Create route <span aria-hidden="true">+</span></button>
</header>

<AlertBanner Message="@alertMessage" IsError="@alertIsError" OnDismiss="@(() => alertMessage = null)" />

<section class="route-section">
    @if (routes.Count == 0)
    {
        <div class="panel empty-state hero-empty"><span>⇄</span><h2>No routes configured</h2><p>Create a bridge from Radarr or Sonarr to Plex. Enabled routes run automatically on their schedule.</p><button class="btn btn-primary" @onclick="OpenRouteForm">Create first route</button></div>
    }
    else
    {
        <div class="route-card-grid">
            @foreach (var route in routes)
            {
                <article class="route-card @(route.Enabled ? "" : "route-disabled")">
                    <div class="route-card-heading"><div><span class="eyebrow">Scheduled every @route.IntervalMinutes min</span><h2>@route.Name</h2></div><StatusBadge Status="@(route.Enabled ? "Enabled" : "Disabled")" /></div>
                    <div class="route-flow">
                        <div><span class="service-mark service-@route.SourceIntegration?.PluginType">@ServiceInitial(route.SourceIntegration?.Name)</span><strong>@route.SourceIntegration?.Name</strong><small>Source</small></div>
                        <span class="flow-line"><i></i><b>→</b></span>
                        <div><span class="service-mark service-@route.TargetIntegration?.PluginType">@ServiceInitial(route.TargetIntegration?.Name)</span><strong>@route.TargetIntegration?.Name</strong><small>Target</small></div>
                    </div>
                    <div class="route-meta"><span><small>Last queued</small><strong>@(route.LastQueuedAt?.ToLocalTime().ToString("g") ?? "Never")</strong></span><span><small>Schedule</small><strong>@(route.Enabled ? $"Every {route.IntervalMinutes} minutes" : "Paused")</strong></span></div>
                    <div class="connection-actions"><button class="btn btn-primary btn-sm" @onclick="() => RunRoute(route)" disabled="@isBusy">Run now</button><button class="text-button" @onclick="() => EditRoute(route)">Edit</button><button class="text-button text-danger" @onclick="() => ConfirmDeleteRoute(route)">Delete</button></div>
                </article>
            }
        </div>
    }
</section>

@if (showRouteForm)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="route-title">
        <div class="modal">
            <div class="modal-heading"><div><span class="eyebrow">Automation route</span><h2 id="route-title">@(routeForm.Id == Guid.Empty ? "Create route" : "Edit route")</h2></div><button class="icon-button" @onclick="CloseRouteForm" type="button">×</button></div>
            <EditForm Model="routeForm" OnValidSubmit="SaveRoute" FormName="SyncRouteForm">
                <DataAnnotationsValidator />
                <div class="form-group"><label>Route name</label><InputText class="form-control" @bind-Value="routeForm.Name" placeholder="Movies to Plex" /></div>
                <div class="form-group"><label>Source</label><InputSelect class="form-control" @bind-Value="routeForm.SourceIntegrationId"><option value="@Guid.Empty">Select a source</option>@foreach (var item in sourceIntegrations) { <option value="@item.Id">@item.Name · @item.PluginType</option> }</InputSelect></div>
                <div class="form-group"><label>Target</label><InputSelect class="form-control" @bind-Value="routeForm.TargetIntegrationId"><option value="@Guid.Empty">Select a target</option>@foreach (var item in targetIntegrations) { <option value="@item.Id">@item.Name · @item.PluginType</option> }</InputSelect></div>
                <div class="form-group"><label>Check interval</label><div class="input-with-suffix"><InputNumber class="form-control" @bind-Value="routeForm.IntervalMinutes" /><span>minutes</span></div><small>BridgeArr queues a sync when this interval has elapsed.</small></div>
                <label class="switch-row"><span><strong>Route enabled</strong><small>Paused routes can still be run manually.</small></span><InputCheckbox @bind-Value="routeForm.Enabled" /></label>
                <div class="modal-actions"><button class="btn btn-primary" type="submit">Save route</button><button class="btn btn-secondary" type="button" @onclick="CloseRouteForm">Cancel</button></div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showRouteDeleteConfirm" Title="Delete route" Message="@routeDeleteMessage" ConfirmLabel="Delete" OnConfirm="ExecuteDeleteRoute" OnCancel="@(() => showRouteDeleteConfirm = false)" />

<LoadingSpinner IsLoading="@isLoading" Text="Loading recent runs…">
    <section class="panel activity-preview">
        <div class="section-header"><div><span class="eyebrow">Latest runs</span><h2>Recent activity</h2></div><a href="/activity" class="text-button">Open full history</a></div>
        @if (filteredJobs.Count == 0)
        {
            <div class="empty-state compact"><p>No sync runs have been recorded yet.</p></div>
        }
        else
        {
            <div class="activity-table">
                @foreach (var job in filteredJobs.Take(8))
                {
                    <button class="activity-table-row" @onclick="() => ViewDetails(job)"><StatusBadge Status="@job.Status.ToString()" /><span><strong>@(job.SourceIntegration?.Name ?? "Source") → @(job.TargetIntegration?.Name ?? "Target")</strong><small>@job.CreatedAt.ToLocalTime().ToString("g")</small></span><span class="activity-result">@FormatDuration(job)</span><span aria-hidden="true">›</span></button>
                }
            </div>
        }
    </section>
</LoadingSpinner>

@if (selectedJob is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><div class="modal-heading"><div><span class="eyebrow">Sync run</span><h2>@selectedJob.SourceIntegration?.Name → @selectedJob.TargetIntegration?.Name</h2></div><button class="icon-button" @onclick="CloseDetails">×</button></div><dl class="detail-grid"><dt>Status</dt><dd><StatusBadge Status="@selectedJob.Status.ToString()" /></dd><dt>Created</dt><dd>@selectedJob.CreatedAt.ToLocalTime().ToString("g")</dd><dt>Duration</dt><dd>@FormatDuration(selectedJob)</dd><dt>Retries</dt><dd>@selectedJob.RetryCount</dd>@if (selectedJob.ErrorMessage is not null) { <dt>Error</dt><dd class="text-danger">@selectedJob.ErrorMessage</dd> }</dl>@if (selectedJob.Payload is not null) { <details class="technical-details"><summary>Technical payload</summary><pre class="code-block">@selectedJob.Payload</pre></details> }@if (selectedJob.Status == SyncJobStatus.Failed) { <div class="modal-actions"><button class="btn btn-primary" @onclick="() => RetryJob(selectedJob)" disabled="@isBusy">Retry run</button></div> }</div></div>
}
@code {
    private bool isLoading = true;
    private bool isBusy;
    private string statusFilter = "";
    private string? alertMessage;
    private bool alertIsError;

    private IReadOnlyList<SyncJob> jobs = Array.Empty<SyncJob>();
    private IReadOnlyList<SyncJob> filteredJobs = Array.Empty<SyncJob>();
    private SyncJob? selectedJob;
    private IReadOnlyList<SyncRoute> routes = Array.Empty<SyncRoute>();
    private IReadOnlyList<Integration> sourceIntegrations = Array.Empty<Integration>();
    private IReadOnlyList<Integration> targetIntegrations = Array.Empty<Integration>();
    private SyncRoute routeForm = new();
    private bool showRouteForm;
    private bool showRouteDeleteConfirm;
    private Guid routeDeleteTargetId;
    private string routeDeleteMessage = string.Empty;

    private async Task LoadRoutes()
    {
        routes = await SyncRouteService.GetAllAsync();
        var integrations = await IntegrationService.GetAllAsync();
        var plugins = IntegrationService.GetAvailablePlugins().ToList();
        var sourceTypes = plugins.Where(x => x.Capabilities.HasFlag(BridgeArr.Plugins.Abstractions.PluginCapabilities.MediaSource)).Select(x => x.PluginType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var targetTypes = plugins.Where(x => x.Capabilities.HasFlag(BridgeArr.Plugins.Abstractions.PluginCapabilities.MediaTarget)).Select(x => x.PluginType).ToHashSet(StringComparer.OrdinalIgnoreCase);
        sourceIntegrations = integrations.Where(x => x.Enabled && sourceTypes.Contains(x.PluginType)).ToList();
        targetIntegrations = integrations.Where(x => x.Enabled && targetTypes.Contains(x.PluginType)).ToList();
    }

    private void OpenRouteForm()
    {
        routeForm = new SyncRoute { Id = Guid.Empty, IntervalMinutes = 60, Enabled = true };
        showRouteForm = true;
    }

    private void EditRoute(SyncRoute route)
    {
        routeForm = new SyncRoute { Id = route.Id, Name = route.Name, SourceIntegrationId = route.SourceIntegrationId, TargetIntegrationId = route.TargetIntegrationId, Enabled = route.Enabled, IntervalMinutes = route.IntervalMinutes, LastQueuedAt = route.LastQueuedAt, CreatedAt = route.CreatedAt };
        showRouteForm = true;
    }

    private void CloseRouteForm() => showRouteForm = false;

    private async Task SaveRoute()
    {
        if (string.IsNullOrWhiteSpace(routeForm.Name)) { ShowError("Route name is required."); return; }
        if (routeForm.SourceIntegrationId == Guid.Empty || routeForm.TargetIntegrationId == Guid.Empty) { ShowError("Select both a source and a target."); return; }
        routeForm.Name = routeForm.Name.Trim();
        try
        {
            if (routeForm.Id == Guid.Empty) await SyncRouteService.CreateAsync(routeForm);
            else await SyncRouteService.UpdateAsync(routeForm);
            showRouteForm = false;
            await LoadRoutes();
            ShowSuccess("Sync route saved.");
        }
        catch (Exception ex) { ShowError($"Failed to save route: {ex.Message}"); }
    }

    private async Task RunRoute(SyncRoute route)
    {
        isBusy = true;
        try
        {
            var job = await SyncRouteService.QueueAsync(route);
            await LoadRoutes();
            await LoadJobs();
            if (job is null) ShowError("A matching sync job is already active.");
            else ShowSuccess($"Sync queued as job {job.Id}.");
        }
        catch (Exception ex) { ShowError($"Failed to run route: {ex.Message}"); }
        finally { isBusy = false; }
    }

    private void ConfirmDeleteRoute(SyncRoute route)
    {
        routeDeleteTargetId = route.Id;
        routeDeleteMessage = $"Delete {route.Name}? Its previous sync activity will remain available.";
        showRouteDeleteConfirm = true;
    }

    private async Task ExecuteDeleteRoute()
    {
        showRouteDeleteConfirm = false;
        try
        {
            await SyncRouteService.DeleteAsync(routeDeleteTargetId);
            await LoadRoutes();
            ShowSuccess("Route deleted.");
        }
        catch (Exception ex) { ShowError($"Could not delete route: {ex.Message}"); }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRoutes();
            await LoadJobs();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadJobs()
    {
        jobs = await SyncJobRepository.GetRecentAsync(100);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(statusFilter) ||
            !Enum.TryParse<SyncJobStatus>(statusFilter, out var filter))
        {
            filteredJobs = jobs;
            return;
        }
        filteredJobs = jobs.Where(j => j.Status == filter).ToList();
    }

    private async Task RetryJob(SyncJob job)
    {
        isBusy = true;
        alertMessage = null;
        try
        {
            var newJob = await SyncService.RequestSyncAsync(
                job.SourceIntegrationId,
                job.TargetIntegrationId,
                job.Payload);

            ShowSuccess($"Retry queued as job {newJob.Id}.");
            selectedJob = null;
            await LoadJobs();
        }
        catch (Exception ex)
        {
            ShowError($"Failed to retry job: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ViewDetails(SyncJob job) => selectedJob = job;
    private void CloseDetails() => selectedJob = null;

    private static string ServiceInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
    private static string FormatDuration(SyncJob job)
    {
        if (job.StartedAt is null || job.CompletedAt is null)
        {
            return "—";
        }
        var duration = job.CompletedAt.Value - job.StartedAt.Value;
        return duration.TotalSeconds < 60
            ? $"{duration.TotalSeconds:F1}s"
            : $"{duration.TotalMinutes:F1}m";
    }

    private void ShowSuccess(string message) { alertMessage = message; alertIsError = false; }
    private void ShowError(string message) { alertMessage = message; alertIsError = true; }
}
