@page "/"
@attribute [Authorize]
@inject BridgeArr.Application.Interfaces.IIntegrationRepository IntegrationRepository
@inject BridgeArr.Application.Interfaces.ISyncJobRepository SyncJobRepository
@inject BridgeArr.Application.Interfaces.ISyncRouteRepository SyncRouteRepository

<PageTitle>Overview – BridgeArr</PageTitle>

<header class="page-header">
    <div>
        <span class="eyebrow">BridgeArr control room</span>
        <h1>Everything flowing?</h1>
        <p>See the health of your connections and label routes at a glance.</p>
    </div>
    <a href="/sync" class="btn btn-primary">Manage routes <span aria-hidden="true">→</span></a>
</header>

<LoadingSpinner IsLoading="@isLoading" Text="Checking your bridges…">
    <section class="health-strip @HealthClass">
        <span class="health-orb"></span>
        <div>
            <strong>@HealthTitle</strong>
            <span>@HealthDescription</span>
        </div>
        <a href="/activity">View activity</a>
    </section>

    <div class="metric-grid">
        <article class="metric-card"><span class="metric-label">Active routes</span><strong>@routes.Count(x => x.Enabled)</strong><small>@routes.Count total configured</small></article>
        <article class="metric-card"><span class="metric-label">Connections</span><strong>@integrations.Count(x => x.Enabled)</strong><small>@integrations.Count total configured</small></article>
        <article class="metric-card"><span class="metric-label">Last 20 runs</span><strong>@recentJobs.Count(x => x.Status == SyncJobStatus.Completed)</strong><small>completed successfully</small></article>
        <article class="metric-card @(failedCount > 0 ? "metric-alert" : "")"><span class="metric-label">Needs attention</span><strong>@failedCount</strong><small>failed runs</small></article>
    </div>

    <div class="dashboard-grid">
        <section class="panel panel-span-2">
            <div class="section-header"><div><span class="eyebrow">Automation</span><h2>Your routes</h2></div><a href="/sync" class="text-button">View all</a></div>
            @if (routes.Count == 0)
            {
                <div class="empty-state"><span>⇄</span><h3>No routes yet</h3><p>Connect a source to Plex and start moving labels.</p><a href="/sync" class="btn btn-primary btn-sm">Create route</a></div>
            }
            else
            {
                <div class="route-list">
                    @foreach (var route in routes.Take(4))
                    {
                        <a class="route-row" href="/sync">
                            <div class="route-connector"><span>@Initial(route.SourceIntegration?.Name)</span><i></i><span>@Initial(route.TargetIntegration?.Name)</span></div>
                            <div class="route-copy"><strong>@route.Name</strong><small>@route.SourceIntegration?.Name → @route.TargetIntegration?.Name</small></div>
                            <div class="route-schedule"><StatusBadge Status="@(route.Enabled ? "Enabled" : "Disabled")" /><small>@LastRun(route)</small></div>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="panel">
            <div class="section-header"><div><span class="eyebrow">Recent</span><h2>Activity</h2></div></div>
            @if (recentJobs.Count == 0)
            {
                <div class="empty-state compact"><p>No sync runs recorded yet.</p></div>
            }
            else
            {
                <div class="activity-list">
                    @foreach (var job in recentJobs.Take(6))
                    {
                        <a class="activity-row" href="/activity"><StatusBadge Status="@job.Status.ToString()" /><span><strong>@job.SourceIntegration?.Name → @job.TargetIntegration?.Name</strong><small>@RelativeTime(job.CreatedAt)</small></span></a>
                    }
                </div>
            }
        </section>
    </div>
</LoadingSpinner>

@code {
    private bool isLoading = true;
    private IReadOnlyList<Integration> integrations = Array.Empty<Integration>();
    private IReadOnlyList<SyncJob> recentJobs = Array.Empty<SyncJob>();
    private IReadOnlyList<SyncRoute> routes = Array.Empty<SyncRoute>();
    private int failedCount => recentJobs.Count(j => j.Status == SyncJobStatus.Failed);
    private string HealthClass => failedCount > 0 ? "health-warning" : routes.Count == 0 ? "health-neutral" : "health-good";
    private string HealthTitle => failedCount > 0 ? "Some runs need attention" : routes.Count == 0 ? "Ready when you are" : "All systems look good";
    private string HealthDescription => failedCount > 0 ? $"{failedCount} of the latest runs failed." : routes.Count == 0 ? "Create your first route to start syncing." : "Your enabled routes are being scheduled normally.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            integrations = await IntegrationRepository.GetAllAsync();
            recentJobs = await SyncJobRepository.GetRecentAsync(20);
            routes = await SyncRouteRepository.GetAllAsync();
        }
        finally { isLoading = false; }
    }

    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
    private static string LastRun(SyncRoute route) => route.LastQueuedAt is null ? "Never run" : $"Last run {RelativeTime(route.LastQueuedAt.Value)}";
    private static string RelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value;
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }
}
