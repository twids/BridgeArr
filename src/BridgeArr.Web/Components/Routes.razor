<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="@AdditionalAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <article class="content-card">
                <h1>Page not found</h1>
                <p>The requested BridgeArr page could not be found.</p>
            </article>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly IReadOnlyList<System.Reflection.Assembly> AdditionalAssemblies =
        [typeof(BridgeArr.Api.DependencyInjection).Assembly];
}
